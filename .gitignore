# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment (regenerate with: python -m venv .venv && pip install -r requirements.txt)
.venv/

# Model/HTTP download caches (redirected here from the OS profile dir, see scripts/*.bat)
.cache/

# Trained checkpoints: large binaries, regenerated by running the training pipeline
checkpoints/
model/checkpoints/
model/sft/checkpoints/

# Raw/tokenized training data: large, regenerated by data prep scripts
model/data/openwebtext/*.bin
model/data/shakespeare_char/*.bin
model/data/shakespeare_char/meta.pkl

# SFT dataset arrays: large, regenerated by model/sft/build_sft_dataset.py
model/sft/*.npy

# Vector store: large binaries, regenerated by toolstore's build scripts
toolstore/vectorstore*.db
toolstore/vectorstore*.faiss
toolstore/corpus/wikipedia_summaries/

# Logs
logs/
*.log

# Claude Code / ClaudeBoost internal tooling and planning docs, not part of the shipped project
.claude/
CLAUDE.md
SPEC.md
workspace/
diagrams.html

# OS/editor cruft
.DS_Store
Thumbs.db
